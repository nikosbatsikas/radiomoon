[Unit]
Description=RadioMoon radio automation server
After=network-online.target sound.target mariadb.service mysql.service mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=radiomoon
Group=radiomoon
SupplementaryGroups=audio
Environment=RADIOMOON_DATA=/var/lib/radiomoon
EnvironmentFile=-/etc/radiomoon/server.env
ExecStart=/opt/radiomoon/radiomoon-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
