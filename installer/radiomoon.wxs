<?xml version="1.0" encoding="UTF-8"?>
<!-- WiX v4 package. Build: wix build installer\radiomoon.wxs -arch x64 -d Version=0.2.1 -d SourceDir=<stage folder> -d IconFile=packaging\icon.ico -o dist\RadioMoon-0.2.1-x64.msi -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RadioMoon" Manufacturer="RadioMoon" Version="$(Version)" UpgradeCode="8F3C2A71-5B4D-4E6A-9C1F-2D7A6B0E4C35" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of RadioMoon is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AppIcon" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="RadioMoon" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuDir" Name="RadioMoon" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <!-- every file of the staged folder (exe, lang, bundled MariaDB on x64) is harvested into one group -->
    <Files Include="$(SourceDir)\**" Directory="INSTALLFOLDER" />

    <DirectoryRef Id="MenuDir">
      <Component Id="MenuShortcut" Guid="3B1E0C54-7A9D-4F2B-8E61-5C0D9A7B2F18">
        <Shortcut Id="StartMenuLink" Name="RadioMoon" Target="[INSTALLFOLDER]RadioMoon.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <Shortcut Id="StartMenuRx" Name="RadioMoon MPX Receiver" Target="[INSTALLFOLDER]RadioMoon-MPX-Receiver.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RemoveFolder Id="RemoveMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\\RadioMoon" Name="menu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="6D2A8E19-0C4B-4B7F-A3D5-91E8F7C20B64">
        <Shortcut Id="DesktopLink" Name="RadioMoon" Target="[INSTALLFOLDER]RadioMoon.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\\RadioMoon" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- no explicit Feature: WiX 4 puts everything into one implicit feature -->
    <!-- user data (database, music settings, backups) lives in %LOCALAPPDATA%\RadioMoon and is never touched by install, upgrade or uninstall -->
  </Package>
</Wix>
